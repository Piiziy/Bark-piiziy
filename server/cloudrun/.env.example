# Copy to cloudrun/.env (gitignored) and fill in. Never commit .env or the .p8 key.
GCP_PROJECT=
REGION=asia-northeast3
SERVICE=homepush

# APNs auth key from developer.apple.com > Keys (Apple Push Notifications service).
APNS_KEY_FILE=$HOME/keys/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=
APNS_TEAM_ID=2M7Z8SF8B4
APNS_TOPIC=com.piiziy.homepush
# true  = app installed from Xcode (development APNs)
# false = TestFlight / App Store build (production APNs)
APNS_SANDBOX=true

# Device token from the app: Settings > Device Token (tap to copy).
# Leave empty on the first deploy; set it and run deploy.sh again.
DEVICE_TOKEN=
