# Copy to .env and fill in. NEVER commit .env or secrets/.
# Public hostname that points (A/AAAA record) at this VPS
BARK_DOMAIN=push.example.com
# Let's Encrypt account e-mail (certificate expiry notices)
ACME_EMAIL=you@example.com

# --- APNs (Apple Developer > Certificates, IDs & Profiles > Keys) ---
# The .p8 itself goes to ./secrets/apns_key.p8 (chmod 600), not here.
BARK_APNS_KEY_ID=XXXXXXXXXX
BARK_APNS_TEAM_ID=XXXXXXXXXX
# Must equal the iOS app bundle ID
BARK_APNS_TOPIC=com.piiziy.homepush
# true only for builds installed straight from Xcode (development push env).
# TestFlight / App Store builds use production -> false.
BARK_APNS_SANDBOX=false

# --- Basic Auth for everything except /ping, /healthz, /register ---
# Pick a long random password, e.g. `openssl rand -base64 24`
BARK_SERVER_BASIC_AUTH_USER=homepush
BARK_SERVER_BASIC_AUTH_PASSWORD=change-me

# Group -> default icon table (default: /data/group-icons.json)
# BARK_GROUP_ICONS_FILE=/data/group-icons.json
