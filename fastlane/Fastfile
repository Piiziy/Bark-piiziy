# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools

default_platform(:ios)

TEAM_ID = "2M7Z8SF8B4"

# Targets signed for App Store distribution -> bundle identifier.
# Keep in sync with app_identifier in Matchfile.
SIGNED_TARGETS = {
  "Bark" => "com.piiziy.homepush",
  "NotificationContentExtension" => "com.piiziy.homepush.NotificationContent",
  "NotificationServiceExtension" => "com.piiziy.homepush.NotificationServiceExtension",
  "WidgetExtension" => "com.piiziy.homepush.Widget",
  "BarkWatch" => "com.piiziy.homepush.watch",
  "BarkWatchNotificationService" => "com.piiziy.homepush.watch.NotificationService",
}

platform :ios do
  desc "Build, sign with match and upload to TestFlight"
  desc "Env: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY (.p8 contents), MATCH_PASSWORD,"
  desc "     MATCH_READONLY (false only to create certificates), HOMEPUSH_PUSH_URL (optional)"
  lane :beta do |options|
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY"),
      duration: 1200,
      in_house: false
    )

    match(type: "appstore", api_key: api_key, readonly: ENV["MATCH_READONLY"] != "false")

    # The project uses automatic signing for local development; switch the
    # Release configuration to the match profiles for this CI build only.
    SIGNED_TARGETS.each do |target, bundle_id|
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "Bark.xcodeproj",
        targets: [target],
        build_configurations: ["Release"],
        team_id: TEAM_ID,
        code_sign_identity: "Apple Distribution",
        profile_name: "match AppStore #{bundle_id}"
      )
    end

    version = options[:version].to_s
    build = options[:build_number].to_s
    build = ENV["GITHUB_RUN_NUMBER"].to_s if build.empty?
    build = Time.now.strftime("%Y%m%d%H%M") if build.empty?
    xcargs = ["CURRENT_PROJECT_VERSION=#{build}"]
    xcargs << "MARKETING_VERSION=#{version}" unless version.empty?

    run_id = ENV["GITHUB_RUN_ID"].to_s
    unless run_id.empty?
      set_info_plist_value(path: "./Bark/Info.plist", key: "GitHub Run Id", value: run_id)
    end

    build_app(
      workspace: "Bark.xcworkspace",
      scheme: "Bark",
      configuration: "Release",
      export_method: "app-store",
      xcargs: xcargs.join(" ")
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)

    push_url = ENV["HOMEPUSH_PUSH_URL"].to_s
    unless push_url.empty?
      title = "HomePush 빌드 #{build} 업로드 완료"
      body = "TestFlight 처리 후 업데이트할 수 있습니다"
      sh("curl", "-fsS", "-o", "/dev/null", "-X", "POST", push_url,
         "-H", "Content-Type: application/json; charset=utf-8",
         "-d", { title: title, body: body, group: "GitHub Actions" }.to_json,
         log: false) rescue UI.important("Build notification failed")
    end
  end

  lane :tests do
    run_tests(workspace: "Bark.xcworkspace", scheme: "Bark")
  end
end
